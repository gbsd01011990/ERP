# Kopieren nach /opt/erp/.env und ausfüllen. Diese Datei NIE ins Repository legen.

# Datenbank: langes Zufallspasswort, z. B. mit  openssl rand -hex 32
DB_PASSWORT=

# Erster Admin-Zugang, wird beim ersten Start angelegt
ADMIN_EMAIL=
ADMIN_PASSWORT=

# Adresse der App, z. B. erp.baumpflegebund.de (DNS-Eintrag Typ A auf die Server-IP setzen)
ERP_DOMAIN=erp.baumpflegebund.de

# "caddy": HTTPS übernimmt der mitgelieferte Caddy (Ports 80 und 443 müssen frei sein).
# Leer lassen, wenn auf dem Server schon ein Webserver läuft (nginx, Apache, Plesk …);
# der leitet dann die Domain auf 127.0.0.1:APP_PORT weiter.
COMPOSE_PROFILES=caddy

# Port der App auf dem Server (nur lokal erreichbar), falls 3000 schon belegt ist
APP_PORT=3000

# Optional
HERO_API_TOKEN=
BACKUP_VERZEICHNIS=/opt/erp/backups

# Schlüssel zum Verschlüsseln gespeicherter Zugangsdaten (Microsoft). Einmal erzeugen und
# NIE ändern, sonst lassen sich gespeicherte Secrets nicht mehr lesen:  openssl rand -hex 32
ERP_SCHLUESSEL=

# Microsoft 365 (optional hier; besser je Mandant unter Einstellungen → Postfächer)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_INTERVALL_SEKUNDEN=120
