{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import:hero": "tsx scripts/hero-import.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test scripts/tests/*.test.ts",
    "test:integration": "NODE_OPTIONS=--require=./scripts/ohne-server-only.cjs tsx --test scripts/tests/*.itest.ts",
    "mail:abruf": "NODE_OPTIONS=--require=./scripts/ohne-server-only.cjs tsx scripts/mail-abruf.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "graphql": "^16.15.0",
    "graphql-yoga": "^5.24.6",
    "next": "^15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
