// Datenmodell ERP – drei Firmen in einer App.
// Fremd-IDs (heroId, lexwareId) halten die Verbindung zu HERO und Lexware.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rolle {
  ADMIN
  BUERO
  KOLONNE
}

enum KontaktTyp {
  KUNDE
  LIEFERANT
  PARTNER
  MITARBEITER
}

enum KontaktKategorie {
  PRIVAT
  GEWERBE
  OEFFENTLICH
}

enum AdressArt {
  HAUPT
  RECHNUNG
  BAUSTELLE
  SONSTIGE
}

enum LogbuchArt {
  NOTIZ
  ANRUF
  EMAIL
  TERMIN
  STATUS
  SYSTEM
}

model Firma {
  id                 String   @id @default(cuid())
  kuerzel            String   @unique // GBSD, RD, KUD
  name               String
  zusatz             String?
  strasse            String?
  plz                String?
  ort                String?
  telefon            String?
  email              String?
  web                String?
  farbe              String   @default("#2f5d3a")
  projektPraefix     String
  // Kalkulationssätze (Angebotsmodul)
  stundensatz        Decimal  @default(58) @db.Decimal(8, 2) // €/h Lohn inkl. Gemeinkosten
  materialAufschlag  Decimal  @default(20) @db.Decimal(5, 2) // % auf Material-EK
  fremdAufschlag     Decimal  @default(15) @db.Decimal(5, 2) // % auf Fremdleistung
  mwstSatz           Decimal  @default(19) @db.Decimal(4, 2)
  angebotGueltigTage Int      @default(14)
  // Rechnungen
  zahlungszielTage   Int      @default(14)
  skontoProzent      Decimal  @default(0) @db.Decimal(4, 2)
  skontoTage         Int      @default(0)
  // Microsoft 365 (App-Berechtigung); leer = Werte aus MS_TENANT_ID/MS_CLIENT_ID/MS_CLIENT_SECRET
  msTenantId         String?
  msClientId         String?
  msClientSecret     String? // verschlüsselt
  createdAt          DateTime @default(now())

  zugriffe           Zugriff[]
  projekte           Projekt[]
  projektTypen       ProjektTyp[]
  status             PipelineStatus[]
  nummernkreise      Nummernkreis[]
  kontaktIds         KontaktFremdId[]
  leistungen         Leistung[]
  angebote           Angebot[]
  lager              Lager[]
  artikel            Artikel[]
  geraete            Geraet[]
  kostenplaene       Kostenplan[]
  sitzungen          Sitzung[]
  apiSchluessel      ApiSchluessel[]
  zeiten             Zeiteintrag[]
  logbuch            LogbuchEintrag[]
  postfaecher        Postfach[]
  emails             Email[]
  aufgaben           Aufgabe[]
  rechnungen         Rechnung[]
  telefonAgent       TelefonAgent?
  gespraeche         Gespraech[]
  termine            Termin[]
  kanalZugaenge      KanalZugang[]
  buchhaltung        Json? // DATEV-Nummern, Konten (SKR03), Mahnregeln
  zahlungen          Zahlung[]
  bankumsaetze       Bankumsatz[]
  mahnungen          Mahnung[]
  bestellungen       Bestellung[]
  eingangsrechnungen Eingangsrechnung[]
  lieferscheine      Lieferschein[]
}

model Benutzer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwortHash String
  rolle        Rolle    @default(BUERO)
  aktiv        Boolean  @default(true)
  createdAt    DateTime @default(now())

  zugriffe                  Zugriff[]
  sitzungen                 Sitzung[]
  logbuch                   LogbuchEintrag[]
  projekte                  Projekt[]          @relation("Verantwortlich")
  angebote                  Angebot[]
  apiSchluessel             ApiSchluessel[]
  lagerBuchungen            LagerBuchung[]
  geraetEreignisse          GeraetEreignis[]
  geraetEinsaetze           GeraetEinsatz[]
  postfaecher               Postfach[]
  postfachZugriffe          PostfachZugriff[]
  aufgabenZustaendig        Aufgabe[]          @relation("AufgabeZustaendig")
  aufgabenErstellt          Aufgabe[]          @relation("AufgabeErsteller")
  zeiten                    Zeiteintrag[]      @relation("ZeitMitarbeiter")
  zeitenErfasst             Zeiteintrag[]      @relation("ZeitErfasser")
  zeitenFreigabe            Zeiteintrag[]      @relation("ZeitFreigabe")
  rechnungenErstellt        Rechnung[]         @relation("RechnungErsteller")
  rechnungenFestgeschrieben Rechnung[]         @relation("RechnungFestschreiber")
  termine                   Termin[]
  gespraecheZustaendig      Gespraech[]
  agentStandard             TelefonAgent[]
  zahlungenErfasst          Zahlung[]
  mahnungenErstellt         Mahnung[]
  bestellungenErstellt      Bestellung[]       @relation("BestellungErsteller")
  bestellungenBestellt      Bestellung[]       @relation("BestellungBesteller")
  wareneingaenge            Wareneingang[]
  eingangsFreigaben         Eingangsrechnung[] @relation("EingangFreigabe")
  lieferscheineErfasst      Lieferschein[]
}

model Zugriff {
  benutzerId String
  firmaId    String
  benutzer   Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)
  firma      Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@id([benutzerId, firmaId])
}

model Sitzung {
  id         String   @id // zufälliges Token (gehasht gespeichert)
  benutzerId String
  firmaId    String? // Mandant, bei dem angemeldet wurde; ohne Mandant ist die Sitzung ungültig
  ablauf     DateTime
  benutzer   Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)
  firma      Firma?   @relation(fields: [firmaId], references: [id], onDelete: Cascade)
}

/// Kundenkartei ist firmenübergreifend; Fremd-IDs je Firma in KontaktFremdId.
model Kontakt {
  id         String           @id @default(cuid())
  nummer     String?          @unique
  typ        KontaktTyp       @default(KUNDE)
  kategorie  KontaktKategorie @default(PRIVAT)
  firmenname String?
  anrede     String?
  vorname    String?
  nachname   String?
  email      String?
  telefon    String?
  mobil      String?
  web        String?
  leitwegId  String?
  notiz      String?
  geloescht  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  adressen        Adresse[]
  ansprechpartner Ansprechpartner[]
  projekte        Projekt[]
  fremdIds        KontaktFremdId[]
  logbuch         LogbuchEintrag[]
  emails          Email[]
  aufgaben        Aufgabe[]

  gespraeche Gespraech[]
  termine    Termin[]

  ustId String? // für § 13b und XRechnung

  bestellungen       Bestellung[]
  eingangsrechnungen Eingangsrechnung[]

  lieferscheine Lieferschein[]

  @@index([nachname])
  @@index([firmenname])
}

model KontaktFremdId {
  id        String  @id @default(cuid())
  kontaktId String
  firmaId   String
  system    String // "HERO" | "LEXWARE"
  fremdId   String
  kontakt   Kontakt @relation(fields: [kontaktId], references: [id], onDelete: Cascade)
  firma     Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([firmaId, system, fremdId])
  @@unique([kontaktId, firmaId, system])
}

model Adresse {
  id        String    @id @default(cuid())
  kontaktId String
  art       AdressArt @default(HAUPT)
  strasse   String?
  zusatz    String?
  plz       String?
  ort       String?
  land      String    @default("DE")
  lat       Float?
  lng       Float?
  kontakt   Kontakt   @relation(fields: [kontaktId], references: [id], onDelete: Cascade)
}

model Ansprechpartner {
  id        String  @id @default(cuid())
  kontaktId String
  name      String
  funktion  String?
  telefon   String?
  email     String?
  kontakt   Kontakt @relation(fields: [kontaktId], references: [id], onDelete: Cascade)
}

model ProjektTyp {
  id       String    @id @default(cuid())
  firmaId  String
  name     String
  heroId   Int?
  firma    Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  projekte Projekt[]

  @@unique([firmaId, name])
}

model PipelineStatus {
  id            String    @id @default(cuid())
  firmaId       String
  name          String
  reihenfolge   Int
  farbe         String    @default("#64748b")
  abgeschlossen Boolean   @default(false)
  verloren      Boolean   @default(false)
  firma         Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  projekte      Projekt[]

  @@unique([firmaId, name])
}

model Nummernkreis {
  id          String  @id @default(cuid())
  firmaId     String
  art         String // PROJEKT, ANGEBOT, AUFTRAG, AUFMASS ...
  praefix     String
  naechste    Int     @default(1)
  stellen     Int     @default(3)
  jahresweise Boolean @default(false) // true: zum Jahreswechsel wieder bei 1 beginnen
  jahr        Int? // Jahr der zuletzt vergebenen Nummer (für jahresweise)
  firma       Firma   @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([firmaId, art])
}

model Projekt {
  id               String   @id @default(cuid())
  firmaId          String
  nummer           String
  titel            String
  beschreibung     String?
  typId            String?
  statusId         String
  kontaktId        String
  verantwortlichId String?
  quelle           String? // Empfehlung, Website, Ausschreibung ...
  volumen          Decimal? @db.Decimal(12, 2)
  baustelleStrasse String?
  baustellePlz     String?
  baustelleOrt     String?
  lat              Float?
  lng              Float?
  heroId           Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  firma           Firma            @relation(fields: [firmaId], references: [id])
  typ             ProjektTyp?      @relation(fields: [typId], references: [id])
  status          PipelineStatus   @relation(fields: [statusId], references: [id])
  kontakt         Kontakt          @relation(fields: [kontaktId], references: [id])
  verantwortlich  Benutzer?        @relation("Verantwortlich", fields: [verantwortlichId], references: [id])
  logbuch         LogbuchEintrag[]
  angebote        Angebot[]
  rechnungen      Rechnung[]
  lagerBuchungen  LagerBuchung[]
  geraetEinsaetze GeraetEinsatz[]
  zeiten          Zeiteintrag[]
  emails          Email[]
  aufgaben        Aufgabe[]

  gespraeche Gespraech[]
  termine    Termin[]

  bestellungen       Bestellung[]
  eingangsrechnungen Eingangsrechnung[]

  lieferscheine Lieferschein[]

  @@unique([firmaId, nummer])
  @@unique([firmaId, heroId])
  @@index([statusId])
}

/// Logbuch eines Projekts oder (ohne Projekt) eines Kontakts im Mandanten.
model LogbuchEintrag {
  id         String     @id @default(cuid())
  projektId  String?
  kontaktId  String?
  firmaId    String? // Pflicht für Kontakt-Einträge: die Kartei ist gemeinsam, Notizen gehören dem Mandanten
  benutzerId String?
  art        LogbuchArt @default(NOTIZ)
  text       String
  createdAt  DateTime   @default(now())
  projekt    Projekt?   @relation(fields: [projektId], references: [id], onDelete: Cascade)
  kontakt    Kontakt?   @relation(fields: [kontaktId], references: [id], onDelete: Cascade)
  firma      Firma?     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  benutzer   Benutzer?  @relation(fields: [benutzerId], references: [id])

  @@index([projektId, createdAt])
  @@index([kontaktId, firmaId, createdAt])
}

// ---------------------------------------------------------------- Angebote

enum BelegArt {
  ANGEBOT
  AUFTRAGSBESTAETIGUNG
}

enum BelegStatus {
  ENTWURF
  VERSENDET
  ANGENOMMEN
  ABGELEHNT
  ERSETZT
}

enum PositionsArt {
  GRUPPE
  POSITION
  TEXT
}

/// Leistungsstamm je Firma. Einzelpreis ergibt sich aus der Kalkulation oder ist fest gesetzt.
model Leistung {
  id         String             @id @default(cuid())
  firmaId    String
  nummer     String
  kategorie  String?
  kurztext   String
  langtext   String?
  einheit    String             @default("Stk.")
  minuten    Decimal            @default(0) @db.Decimal(10, 2) // Lohnminuten je Einheit
  materialEk Decimal            @default(0) @db.Decimal(12, 2)
  geraete    Decimal            @default(0) @db.Decimal(12, 2) // Maschinen/Geräte je Einheit (Verrechnungspreis)
  fremdEk    Decimal            @default(0) @db.Decimal(12, 2)
  festpreis  Decimal?           @db.Decimal(12, 2)
  aktiv      Boolean            @default(true)
  lexwareId  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  firma      Firma              @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  positionen AngebotsPosition[]

  @@unique([firmaId, nummer])
}

model Angebot {
  id                String      @id @default(cuid())
  firmaId           String
  projektId         String
  art               BelegArt    @default(ANGEBOT)
  nummer            String
  version           Int         @default(1)
  status            BelegStatus @default(ENTWURF)
  datum             DateTime    @default(now())
  gueltigBis        DateTime?
  betreff           String
  anrede            String?
  einleitung        String?
  vorbemerkung      String?
  schlusstext       String?
  mwstSatz          Decimal     @db.Decimal(4, 2)
  stundensatz       Decimal     @db.Decimal(8, 2) // Sätze zum Zeitpunkt der Erstellung einfrieren
  materialAufschlag Decimal     @db.Decimal(5, 2)
  fremdAufschlag    Decimal     @db.Decimal(5, 2)
  netto             Decimal     @default(0) @db.Decimal(12, 2)
  vorgaengerId      String?
  erstelltVonId     String?
  // GAEB: Originaldatei des Auftraggebers, damit X84/X86 exakt auf dessen LV antworten
  gaebQuelle        Bytes?
  gaebName          String?
  gaebPhase         String?
  gaebInfo          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  firma       Firma              @relation(fields: [firmaId], references: [id])
  projekt     Projekt            @relation(fields: [projektId], references: [id], onDelete: Cascade)
  erstelltVon Benutzer?          @relation(fields: [erstelltVonId], references: [id])
  vorgaenger  Angebot?           @relation("Folge", fields: [vorgaengerId], references: [id])
  nachfolger  Angebot[]          @relation("Folge")
  positionen  AngebotsPosition[]
  rechnungen  Rechnung[]

  @@unique([firmaId, nummer, version])
  @@index([projektId])
}

model AngebotsPosition {
  id                  String              @id @default(cuid())
  angebotId           String
  reihenfolge         Int
  art                 PositionsArt        @default(POSITION)
  kurztext            String
  langtext            String?
  menge               Decimal             @default(1) @db.Decimal(12, 3)
  einheit             String              @default("Stk.")
  minuten             Decimal             @default(0) @db.Decimal(10, 2)
  materialEk          Decimal             @default(0) @db.Decimal(12, 2)
  geraete             Decimal             @default(0) @db.Decimal(12, 2)
  fremdEk             Decimal             @default(0) @db.Decimal(12, 2)
  einzelpreis         Decimal             @default(0) @db.Decimal(12, 2)
  preisFest           Boolean             @default(false) // true: Einzelpreis von Hand gesetzt, nicht aus Kalkulation
  bedarf              Boolean             @default(false) // Bedarfs-/Alternativposition: nicht in der Summe
  ebene               Int                 @default(1) // Titelebene (GAEB: Los/Titel/Untertitel)
  oz                  String? // Ordnungszahl aus GAEB; sonst wird nummeriert
  gaebId              String? // Item-/Kategorie-ID im GAEB-LV des Auftraggebers
  gaebTyp             String? // Normal, LumpSum, Eventual, Alternative, Markup …
  leistungId          String?
  angebot             Angebot             @relation(fields: [angebotId], references: [id], onDelete: Cascade)
  leistung            Leistung?           @relation(fields: [leistungId], references: [id])
  aufmass             AufmassZeile[]
  rechnungsPositionen RechnungsPosition[]

  @@index([angebotId, reihenfolge])
}

/// Aufmaßzeile: Anzahl × Länge × Breite × Höhe (leere Faktoren zählen als 1). Abzug zieht ab.
model AufmassZeile {
  id          String           @id @default(cuid())
  positionId  String
  reihenfolge Int
  text        String?
  anzahl      Decimal?         @db.Decimal(12, 3)
  laenge      Decimal?         @db.Decimal(12, 3)
  breite      Decimal?         @db.Decimal(12, 3)
  hoehe       Decimal?         @db.Decimal(12, 3)
  abzug       Boolean          @default(false)
  reb         String? // Zeilen nach REB 23.003 (z. B. aus GAEB X31)
  createdAt   DateTime         @default(now())
  position    AngebotsPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, reihenfolge])
}

/// API-Schlüssel für die GraphQL-Schnittstelle. Gespeichert wird nur der SHA-256-Hash;
/// der Klartext wird beim Anlegen einmal angezeigt. Rechte = Rechte des Benutzers.
model ApiSchluessel {
  id            String    @id @default(cuid())
  benutzerId    String
  name          String
  hash          String    @unique
  firmaId       String? // Mandant, für den der Schlüssel gilt; Schlüssel ohne Mandant werden abgewiesen
  anfang        String // erste Zeichen zur Wiedererkennung, z. B. "erp_a1b2c3"
  nurLesen      Boolean   @default(false)
  letzteNutzung DateTime?
  widerrufenAm  DateTime?
  createdAt     DateTime  @default(now())
  benutzer      Benutzer  @relation(fields: [benutzerId], references: [id], onDelete: Cascade)
  firma         Firma?    @relation(fields: [firmaId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- Lager

enum LagerArt {
  HAUPTLAGER
  AUSSENLAGER
  FAHRZEUG
  BAUSTELLE
}

enum BuchungsArt {
  ZUGANG // Wareneingang mit EK-Preis
  ABGANG // Verbrauch, Schwund, Entsorgung
  UMBUCHUNG // von Lager zu Lager
  PROJEKT // Entnahme auf ein Projekt (Ist-Kosten)
  INVENTUR // Korrektur auf gezählten Bestand
}

model Lager {
  id        String         @id @default(cuid())
  firmaId   String
  name      String
  art       LagerArt       @default(HAUPTLAGER)
  adresse   String?
  aktiv     Boolean        @default(true)
  createdAt DateTime       @default(now())
  firma     Firma          @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  bestaende Bestand[]
  abgaenge  LagerBuchung[] @relation("VonLager")
  zugaenge  LagerBuchung[] @relation("NachLager")
  geraete   Geraet[]

  bestellungen Bestellung[]

  @@unique([firmaId, name])
}

model Artikel {
  id             String         @id @default(cuid())
  firmaId        String
  nummer         String
  bezeichnung    String
  kategorie      String?
  einheit        String         @default("Stk.")
  durchschnittEk Decimal        @default(0) @db.Decimal(12, 4) // gleitender Durchschnitt, Basis der Bestandsbewertung
  letzterEk      Decimal?       @db.Decimal(12, 4)
  mindestbestand Decimal?       @db.Decimal(12, 3) // Summe über alle Lager
  lieferant      String?
  aktiv          Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  firma          Firma          @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  bestaende      Bestand[]
  buchungen      LagerBuchung[]

  bestellPositionen BestellPosition[]

  @@unique([firmaId, nummer])
}

model Bestand {
  artikelId String
  lagerId   String
  menge     Decimal @default(0) @db.Decimal(12, 3)
  artikel   Artikel @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  lager     Lager   @relation(fields: [lagerId], references: [id], onDelete: Cascade)

  @@id([artikelId, lagerId])
}

/// Unveränderliches Lagerjournal. Korrekturen laufen über neue Buchungen.
model LagerBuchung {
  id          String      @id @default(cuid())
  artikelId   String
  art         BuchungsArt
  menge       Decimal     @db.Decimal(12, 3) // immer positiv; bei INVENTUR die Differenz mit Vorzeichen
  vonLagerId  String?
  nachLagerId String?
  ekPreis     Decimal?    @db.Decimal(12, 4) // Zugang: Einkaufspreis; sonst Bewertungspreis zum Buchungszeitpunkt
  wert        Decimal     @default(0) @db.Decimal(12, 2)
  projektId   String?
  beleg       String? // Lieferschein-Nr. o. Ä.
  notiz       String?
  benutzerId  String?
  createdAt   DateTime    @default(now())
  artikel     Artikel     @relation(fields: [artikelId], references: [id], onDelete: Cascade)
  vonLager    Lager?      @relation("VonLager", fields: [vonLagerId], references: [id])
  nachLager   Lager?      @relation("NachLager", fields: [nachLagerId], references: [id])
  projekt     Projekt?    @relation(fields: [projektId], references: [id])
  benutzer    Benutzer?   @relation(fields: [benutzerId], references: [id])

  wareneingangPositionen WareneingangPosition[]

  @@index([artikelId, createdAt])
  @@index([projektId])
}

// ---------------------------------------------------------------- Geräte und Maschinen

enum GeraetKategorie {
  FAHRZEUG
  MASCHINE
  ANHAENGER
  KLEINGERAET
  WERKZEUG
}

enum GeraetStatus {
  VERFUEGBAR
  IM_EINSATZ
  WERKSTATT
  DEFEKT
  AUSGEMUSTERT
}

enum PruefArt {
  UVV
  HU
  AU
  WARTUNG
  INSPEKTION
  ELEKTROPRUEFUNG
  SONSTIGE
}

enum EreignisArt {
  PRUEFUNG
  WARTUNG
  REPARATUR
  SCHADEN
  NOTIZ
}

model Geraet {
  id                 String           @id @default(cuid())
  firmaId            String
  inventarNr         String
  bezeichnung        String
  kategorie          GeraetKategorie  @default(MASCHINE)
  status             GeraetStatus     @default(VERFUEGBAR)
  hersteller         String?
  modell             String?
  seriennummer       String?
  kennzeichen        String?
  baujahr            Int?
  lagerId            String? // Standort
  betriebsstunden    Decimal?         @db.Decimal(10, 1)
  kmStand            Int?
  notiz              String?
  // Maschinenkalkulation (je Jahr)
  anschaffungAm      DateTime?
  anschaffungspreis  Decimal?         @db.Decimal(12, 2)
  nutzungsdauerJahre Int?
  einsatzstundenJahr Int?
  zinsProzent        Decimal          @default(5) @db.Decimal(5, 2) // kalk. Zins auf das halbe Anschaffungskapital
  reparaturProzent   Decimal          @default(8) @db.Decimal(5, 2) // Reparatur/Wartung in % vom Anschaffungspreis je Jahr
  fixkostenJahr      Decimal          @default(0) @db.Decimal(12, 2) // Versicherung, Steuer, Garage
  betriebskostenStd  Decimal          @default(0) @db.Decimal(10, 2) // Kraftstoff, Schmierstoffe je Stunde
  verrechnungssatz   Decimal?         @db.Decimal(10, 2) // fester Satz statt Kalkulation
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  firma              Firma            @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  lager              Lager?           @relation(fields: [lagerId], references: [id])
  pruefungen         GeraetPruefung[]
  ereignisse         GeraetEreignis[]
  einsaetze          GeraetEinsatz[]

  @@unique([firmaId, inventarNr])
}

model GeraetPruefung {
  id              String    @id @default(cuid())
  geraetId        String
  art             PruefArt
  bezeichnung     String?
  intervallMonate Int?
  letzteAm        DateTime?
  naechsteAm      DateTime?
  geraet          Geraet    @relation(fields: [geraetId], references: [id], onDelete: Cascade)

  @@index([naechsteAm])
}

model GeraetEreignis {
  id              String      @id @default(cuid())
  geraetId        String
  art             EreignisArt
  datum           DateTime    @default(now())
  text            String
  kosten          Decimal?    @db.Decimal(12, 2)
  betriebsstunden Decimal?    @db.Decimal(10, 1)
  benutzerId      String?
  createdAt       DateTime    @default(now())
  geraet          Geraet      @relation(fields: [geraetId], references: [id], onDelete: Cascade)
  benutzer        Benutzer?   @relation(fields: [benutzerId], references: [id])

  @@index([geraetId, datum])
}

model GeraetEinsatz {
  id         String    @id @default(cuid())
  geraetId   String
  projektId  String
  datum      DateTime
  stunden    Decimal   @db.Decimal(8, 2)
  kostensatz Decimal   @db.Decimal(10, 2) // Satz zum Zeitpunkt des Einsatzes eingefroren
  notiz      String?
  benutzerId String?
  createdAt  DateTime  @default(now())
  geraet     Geraet    @relation(fields: [geraetId], references: [id], onDelete: Cascade)
  projekt    Projekt   @relation(fields: [projektId], references: [id], onDelete: Cascade)
  benutzer   Benutzer? @relation(fields: [benutzerId], references: [id])

  @@index([projektId])
  @@index([geraetId, datum])
}

// ---------------------------------------------------------------- Plankostenrechnung

enum Verteilung {
  LOHN // Gemeinkosten werden auf die produktiven Stunden umgelegt
  MATERIAL // Zuschlag auf Material-EK
  FREMD // Zuschlag auf Fremdleistung
}

model Kostenplan {
  id                     String            @id @default(cuid())
  firmaId                String
  jahr                   Int
  bezeichnung            String?
  // Personal
  mitarbeiter            Decimal           @default(0) @db.Decimal(6, 2) // gewerbliche Mitarbeiter (Vollzeit-Äquivalent)
  bezahlteStundenJahr    Decimal           @default(1720) @db.Decimal(7, 1) // je Mitarbeiter
  produktivProzent       Decimal           @default(85) @db.Decimal(5, 2) // Anteil auf Baustellen abrechenbar
  mittellohn             Decimal           @default(0) @db.Decimal(8, 2) // €/h brutto
  lohnnebenkostenProzent Decimal           @default(85) @db.Decimal(5, 2) // Sozialkosten, Urlaub, Feiertage, Krankheit
  // Einsatz
  materialEinsatzJahr    Decimal           @default(0) @db.Decimal(12, 2)
  fremdEinsatzJahr       Decimal           @default(0) @db.Decimal(12, 2)
  wagnisGewinnProzent    Decimal           @default(8) @db.Decimal(5, 2)
  uebernommenAm          DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  firma                  Firma             @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  zeilen                 KostenplanZeile[]

  @@unique([firmaId, jahr])
}

model KostenplanZeile {
  id          String     @id @default(cuid())
  planId      String
  reihenfolge Int
  gruppe      String // z. B. Personal Verwaltung, Fahrzeuge, Gebäude, Versicherungen
  bezeichnung String
  betragJahr  Decimal    @db.Decimal(12, 2)
  verteilung  Verteilung @default(LOHN)
  plan        Kostenplan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, reihenfolge])
}

// ---------------------------------------------------------------- Zeiterfassung

enum ZeitKategorie {
  UMSETZUNG // Arbeit auf der Baustelle
  FAHRZEIT
  VOR_ORT_TERMIN
  PROJEKTIERUNG
  BUEROARBEIT
  AUFGABE
  PAUSE // zählt nicht als Arbeitszeit
  SONSTIGE
}

/// Ein Zeitblock eines Mitarbeiters. ende = null: Stempeluhr läuft.
/// Nach der Freigabe durch das Büro gesperrt.
model Zeiteintrag {
  id               String        @id @default(cuid())
  firmaId          String
  benutzerId       String // Mitarbeiter
  projektId        String?
  kategorie        ZeitKategorie @default(UMSETZUNG)
  beginn           DateTime
  ende             DateTime?
  notiz            String?
  erfasstVonId     String? // wer gebucht hat (Büro kann für Mitarbeiter nachtragen)
  freigegebenAm    DateTime?
  freigegebenVonId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  firma            Firma         @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  benutzer         Benutzer      @relation("ZeitMitarbeiter", fields: [benutzerId], references: [id], onDelete: Cascade)
  projekt          Projekt?      @relation(fields: [projektId], references: [id])
  erfasstVon       Benutzer?     @relation("ZeitErfasser", fields: [erfasstVonId], references: [id])
  freigegebenVon   Benutzer?     @relation("ZeitFreigabe", fields: [freigegebenVonId], references: [id])

  @@index([firmaId, benutzerId, beginn])
  @@index([projektId])
}

// ---------------------------------------------------------------- E-Mail (Microsoft 365)

enum PostfachArt {
  PERSOENLICH // Postfach eines Mitarbeiters, nur er sieht nicht zugeordnete Mails
  GETEILT // z. B. info@ oder rechnung@, sichtbar für freigegebene Mitarbeiter
}

/// Microsoft-365-Postfach im Mandanten. Abruf über die App-Berechtigung der Firma (kein Login je Mitarbeiter).
model Postfach {
  id               String            @id @default(cuid())
  firmaId          String
  art              PostfachArt       @default(PERSOENLICH)
  adresse          String
  name             String? // Anzeigename, z. B. "Info" oder "Rechnungen"
  benutzerId       String? // Inhaber bei persönlichen Postfächern
  deltaPosteingang String?
  deltaGesendet    String?
  abrufAb          DateTime // erster Abruf ab diesem Datum
  letzterAbruf     DateTime?
  fehler           String?
  aktiv            Boolean           @default(true)
  createdAt        DateTime          @default(now())
  firma            Firma             @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  benutzer         Benutzer?         @relation(fields: [benutzerId], references: [id], onDelete: SetNull)
  zugriffe         PostfachZugriff[]
  emails           Email[]

  rechnungseingang Boolean @default(false) // Anhänge (PDF, XML) werden als Eingangsrechnung angelegt

  lieferscheineingang Boolean @default(false) // Anhänge (Fotos, PDF) werden als Lieferschein erfasst

  @@unique([firmaId, adresse])
}

/// Freigabe eines geteilten Postfachs für einen Mitarbeiter (lesen und daraus senden).
model PostfachZugriff {
  postfachId String
  benutzerId String
  postfach   Postfach @relation(fields: [postfachId], references: [id], onDelete: Cascade)
  benutzer   Benutzer @relation(fields: [benutzerId], references: [id], onDelete: Cascade)

  @@id([postfachId, benutzerId])
}

enum EmailRichtung {
  EINGANG
  AUSGANG
}

model Email {
  id           String        @id @default(cuid())
  firmaId      String
  postfachId   String
  graphId      String // ID bei Microsoft
  internetId   String? // Message-ID-Header, erkennt dieselbe Mail in mehreren Postfächern
  konversation String?
  richtung     EmailRichtung
  betreff      String
  vonName      String?
  vonAdresse   String
  an           String[] // Adressen
  cc           String[]
  vorschau     String?
  text         String? // Klartext (HTML wird nicht gespeichert)
  hatAnhaenge  Boolean       @default(false)
  webLink      String? // Öffnen in Outlook im Web
  empfangenAm  DateTime
  gelesen      Boolean       @default(false)
  kontaktId    String?
  projektId    String?
  zuordnung    String? // AUTO | HAND
  ignoriert    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  firma        Firma         @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  postfach     Postfach      @relation(fields: [postfachId], references: [id], onDelete: Cascade)
  kontakt      Kontakt?      @relation(fields: [kontaktId], references: [id], onDelete: SetNull)
  projekt      Projekt?      @relation(fields: [projektId], references: [id], onDelete: SetNull)
  aufgaben     Aufgabe[]

  eingangsrechnungen Eingangsrechnung[]

  lieferscheine Lieferschein[]

  @@unique([postfachId, graphId])
  @@index([firmaId, empfangenAm])
  @@index([kontaktId])
  @@index([projektId])
}

// ---------------------------------------------------------------- CRM: Aufgaben und Wiedervorlagen

model Aufgabe {
  id            String    @id @default(cuid())
  firmaId       String
  titel         String
  notiz         String?
  faelligAm     DateTime? // Tag (12:00 UTC)
  zustaendigId  String?
  erstelltVonId String?
  kontaktId     String?
  projektId     String?
  emailId       String?
  erledigtAm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  firma         Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  zustaendig    Benutzer? @relation("AufgabeZustaendig", fields: [zustaendigId], references: [id], onDelete: SetNull)
  erstelltVon   Benutzer? @relation("AufgabeErsteller", fields: [erstelltVonId], references: [id], onDelete: SetNull)
  kontakt       Kontakt?  @relation(fields: [kontaktId], references: [id], onDelete: SetNull)
  projekt       Projekt?  @relation(fields: [projektId], references: [id], onDelete: Cascade)
  email         Email?    @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([firmaId, erledigtAm, faelligAm])
  @@index([zustaendigId, erledigtAm])
}

// ---------------------------------------------------------------- Rechnungen
// GoBD: Ein Entwurf ist frei änderbar und hat keine Nummer. Beim Festschreiben
// vergibt der Nummernkreis RECHNUNG die nächste Nummer, Summen und Anschrift
// werden eingefroren und das PDF gespeichert. Danach ändert nur noch ein Storno
// oder eine Rechnungskorrektur etwas.

enum RechnungsArt {
  RECHNUNG
  ABSCHLAG
  TEILSCHLUSS
  SCHLUSS
  KORREKTUR
  STORNO
}

enum RechnungsStatus {
  ENTWURF
  FESTGESCHRIEBEN
  STORNIERT
}

enum AbschlagsModus {
  AUFMASS // kumuliert nach Leistungsstand, frühere Abschläge werden abgezogen
  PLAN // Prozentsatz der Auftragssumme laut Zahlungsplan
}

/// Kostenart einer Rechnungsposition für den Ausweis nach § 35a EStG.
enum Kostenart {
  LOHN
  MASCHINE
  FAHRT
  MATERIAL
  GEMISCHT // begünstigter Anteil je Einheit steht in lohnEp
}

model Rechnung {
  id                   String          @id @default(cuid())
  firmaId              String
  projektId            String
  angebotId            String? // Auftragsgrundlage (Angebot oder Auftragsbestätigung)
  bezugId              String? // Storno/Korrektur: die berichtigte Rechnung
  art                  RechnungsArt    @default(RECHNUNG)
  status               RechnungsStatus @default(ENTWURF)
  nummer               String? // erst beim Festschreiben vergeben
  abschlagNr           Int? // 1., 2., … Abschlag zum Auftrag
  abschlagModus        AbschlagsModus?
  planProzent          Decimal?        @db.Decimal(6, 2)
  datum                DateTime        @default(now())
  leistungVon          DateTime?
  leistungBis          DateTime?
  betreff              String
  anrede               String?
  einleitung           String?
  schlusstext          String?
  kundenReferenz       String? // Bestellnummer bzw. Leitweg-ID des Auftraggebers
  mwstSatz             Decimal         @db.Decimal(4, 2)
  steuerschuldUmkehr   Boolean         @default(false) // § 13b UStG
  s35a                 Boolean         @default(false)
  zahlungszielTage     Int             @default(14)
  skontoProzent        Decimal         @default(0) @db.Decimal(4, 2)
  skontoTage           Int             @default(0)
  einbehaltProzent     Decimal         @default(0) @db.Decimal(4, 2) // Sicherheitseinbehalt (VOB/B § 17)
  aufmassAnhang        Boolean         @default(true) // Mengennachweis mit ausgeben
  // eingefroren beim Festschreiben
  netto                Decimal         @default(0) @db.Decimal(12, 2) // Rechnungsbetrag netto (nach Abzügen)
  mwst                 Decimal         @default(0) @db.Decimal(12, 2)
  brutto               Decimal         @default(0) @db.Decimal(12, 2)
  einbehalt            Decimal         @default(0) @db.Decimal(12, 2)
  zahlbetrag           Decimal         @default(0) @db.Decimal(12, 2)
  lohnBrutto           Decimal         @default(0) @db.Decimal(12, 2) // § 35a, Anteil dieser Rechnung
  berechnung           Json?
  empfaenger           Json?
  pdf                  Bytes?
  festgeschriebenAm    DateTime?
  festgeschriebenVonId String?
  erstelltVonId        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  firma              Firma               @relation(fields: [firmaId], references: [id])
  projekt            Projekt             @relation(fields: [projektId], references: [id])
  angebot            Angebot?            @relation(fields: [angebotId], references: [id])
  bezug              Rechnung?           @relation("Bezug", fields: [bezugId], references: [id])
  folge              Rechnung[]          @relation("Bezug")
  erstelltVon        Benutzer?           @relation("RechnungErsteller", fields: [erstelltVonId], references: [id])
  festgeschriebenVon Benutzer?           @relation("RechnungFestschreiber", fields: [festgeschriebenVonId], references: [id])
  positionen         RechnungsPosition[]
  verrechnungen      Verrechnung[]       @relation("Verrechnet")
  verrechnetIn       Verrechnung[]       @relation("Vorrechnung")

  zahlungen Zahlung[]
  mahnungen Mahnung[]

  xml       String? // CII EN 16931, ins PDF eingebettet (ZUGFeRD)
  xrechnung String? // CII XRechnung 3.0
  eHinweis  String? // warum keine (vollständige) E-Rechnung entstand

  @@unique([firmaId, nummer])
  @@index([projektId])
  @@index([angebotId])
}

model RechnungsPosition {
  id                 String             @id @default(cuid())
  rechnungId         String
  reihenfolge        Int
  art                PositionsArt       @default(POSITION)
  ebene              Int                @default(1)
  oz                 String?
  kurztext           String
  langtext           String?
  menge              Decimal            @default(0) @db.Decimal(12, 3) // bei Aufmaß: Summe der Aufmaßzeilen (kumuliert)
  einheit            String             @default("Stk.")
  einzelpreis        Decimal            @default(0) @db.Decimal(12, 2)
  kostenart          Kostenart          @default(MATERIAL)
  lohnEp             Decimal            @default(0) @db.Decimal(12, 2)
  auftragsMenge      Decimal?           @db.Decimal(12, 3) // Menge laut Auftrag, zum Vergleich
  angebotsPositionId String?
  rechnung           Rechnung           @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  angebotsPosition   AngebotsPosition?  @relation(fields: [angebotsPositionId], references: [id], onDelete: SetNull)
  aufmass            RechnungsAufmass[]

  @@index([rechnungId, reihenfolge])
}

/// Mengennachweis (REB 23.003): Faktoren oder Formel, je Zeile mit Datum der Feststellung.
model RechnungsAufmass {
  id          String            @id @default(cuid())
  positionId  String
  reihenfolge Int
  datum       DateTime?
  text        String?
  formel      String? // z. B. "12,5*3,2 - 2*(0,8*0,8)"; hat Vorrang vor den Faktoren
  anzahl      Decimal?          @db.Decimal(12, 3)
  laenge      Decimal?          @db.Decimal(12, 3)
  breite      Decimal?          @db.Decimal(12, 3)
  hoehe       Decimal?          @db.Decimal(12, 3)
  abzug       Boolean           @default(false)
  reb         String?
  position    RechnungsPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, reihenfolge])
}

/// Frühere Rechnung, die in dieser Rechnung abgezogen wird (Abschläge, Teilschlussrechnungen).
/// Beträge sind die eingefrorenen Werte der Vorrechnung.
model Verrechnung {
  id         String   @id @default(cuid())
  rechnungId String
  vorId      String
  netto      Decimal  @db.Decimal(12, 2)
  mwst       Decimal  @db.Decimal(12, 2)
  brutto     Decimal  @db.Decimal(12, 2)
  einbehalt  Decimal  @default(0) @db.Decimal(12, 2)
  lohnBrutto Decimal  @default(0) @db.Decimal(12, 2)
  rechnung   Rechnung @relation("Verrechnet", fields: [rechnungId], references: [id], onDelete: Cascade)
  vor        Rechnung @relation("Vorrechnung", fields: [vorId], references: [id])

  @@unique([rechnungId, vorId])
}

// ------------------------------------------------- Telefonagent und Messenger
// Jede Firma hat ihren eigenen Agenten: eigene Nummer, Begrüßung, Regeln und Daten.
// Die Sprachplattform (ElevenLabs mit Claude) ruft die Werkzeuge unter
// /api/agent/<kuerzel>/... auf und meldet jedes beendete Gespräch zurück.

enum Kanal {
  TELEFON
  WHATSAPP
  TELEGRAM
  SMS
  THREEMA
}

enum GespraechStatus {
  OFFEN
  ERLEDIGT
}

model TelefonAgent {
  id                   String    @id @default(cuid())
  firmaId              String    @unique
  aktiv                Boolean   @default(false)
  name                 String    @default("Assistenz") // so stellt sich der Agent vor
  begruessung          String
  anweisungen          String? // Zusatzregeln der Firma
  leistungen           String? // was die Firma anbietet und was nicht
  buerozeiten          Json // { "1": ["07:00","16:00"], … } Mo=1 … So=7
  terminZeiten         Json // Zeitfenster für Besichtigungen, gleiche Form
  terminDauerMin       Int       @default(60)
  terminVorlaufTage    Int       @default(2) // frühester Termin ab heute
  terminTageVoraus     Int       @default(21)
  weiterleitungen      Json      @default("[]") // [{ name, nummer, wofuer }]
  notfallNummer        String?
  notfallRegel         String?
  standardZustaendigId String?
  agentId              String? // ID des Agenten bei der Sprachplattform
  schluesselHash       String? // SHA-256 des Werkzeug-Schlüssels
  schluesselVorschau   String?
  webhookGeheimnis     String? // HMAC-Geheimnis der Sprachplattform, verschlüsselt
  updatedAt            DateTime  @updatedAt
  firma                Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  standardZustaendig   Benutzer? @relation(fields: [standardZustaendigId], references: [id], onDelete: SetNull)
}

/// Ein Anruf oder ein Messenger-Verlauf mit einem Absender.
model Gespraech {
  id              String               @id @default(cuid())
  firmaId         String
  kanal           Kanal
  externId        String? // Gesprächs-ID der Plattform bzw. Chat-ID
  absender        String // Rufnummer oder Messenger-Kennung
  absenderName    String?
  kontaktId       String?
  projektId       String?
  zustaendigId    String?
  status          GespraechStatus      @default(OFFEN)
  anliegen        String?
  zusammenfassung String?
  ergebnis        String? // z. B. Termin gebucht, weiterverbunden, Rückruf
  dringend        Boolean              @default(false)
  beginn          DateTime             @default(now())
  dauerSek        Int?
  aufnahmeUrl     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  firma           Firma                @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kontakt         Kontakt?             @relation(fields: [kontaktId], references: [id], onDelete: SetNull)
  projekt         Projekt?             @relation(fields: [projektId], references: [id], onDelete: SetNull)
  zustaendig      Benutzer?            @relation(fields: [zustaendigId], references: [id], onDelete: SetNull)
  nachrichten     GespraechNachricht[]
  termine         Termin[]

  @@unique([firmaId, kanal, externId])
  @@index([firmaId, status, beginn])
  @@index([kontaktId])
}

model GespraechNachricht {
  id          String    @id @default(cuid())
  gespraechId String
  externId    String? // Nachrichten-ID des Messengers (gegen doppelte Zustellung)
  benutzerId  String? // wer im Büro geantwortet hat
  von         String // KUNDE, AGENT, MITARBEITER, WERKZEUG
  text        String
  zeit        DateTime  @default(now())
  gespraech   Gespraech @relation(fields: [gespraechId], references: [id], onDelete: Cascade)

  @@index([gespraechId, externId])
  @@index([gespraechId, zeit])
}

enum TerminArt {
  BESICHTIGUNG
  RUECKRUF
  BERATUNG
  AUSFUEHRUNG
  SONSTIGES
}

model Termin {
  id           String     @id @default(cuid())
  firmaId      String
  art          TerminArt  @default(BESICHTIGUNG)
  titel        String
  beginn       DateTime
  ende         DateTime
  ort          String?
  notiz        String?
  kontaktId    String?
  projektId    String?
  zustaendigId String?
  gespraechId  String?
  quelle       String? // Telefonagent, Büro …
  abgesagt     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  firma        Firma      @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  kontakt      Kontakt?   @relation(fields: [kontaktId], references: [id], onDelete: SetNull)
  projekt      Projekt?   @relation(fields: [projektId], references: [id], onDelete: SetNull)
  zustaendig   Benutzer?  @relation(fields: [zustaendigId], references: [id], onDelete: SetNull)
  gespraech    Gespraech? @relation(fields: [gespraechId], references: [id], onDelete: SetNull)

  @@index([firmaId, beginn])
}

/// Zugang zu einem Messenger je Firma. Geheimnisse (Tokens) liegen verschlüsselt in `geheim`.
model KanalZugang {
  id          String   @id @default(cuid())
  firmaId     String
  kanal       Kanal
  aktiv       Boolean  @default(false)
  kennung     String? // Telegram: Bot-Name; WhatsApp: Phone-Number-ID; SMS: Absendernummer
  geheim      String? // verschlüsseltes JSON mit Tokens
  abwesenheit String? // automatische Antwort außerhalb der Bürozeiten
  updatedAt   DateTime @updatedAt
  firma       Firma    @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@unique([firmaId, kanal])
}

// ---------------------------------------------------------------- Zahlungen und Mahnwesen

enum ZahlungsArt {
  UEBERWEISUNG
  LASTSCHRIFT
  BAR
  SKONTO // gewährter Skontoabzug
  AUSBUCHUNG // Forderungsverlust oder Kleinbetrag
}

model Zahlung {
  id           String      @id @default(cuid())
  firmaId      String
  rechnungId   String
  datum        DateTime
  betrag       Decimal     @db.Decimal(12, 2)
  art          ZahlungsArt @default(UEBERWEISUNG)
  notiz        String?
  bankumsatzId String?
  erfasstVonId String?
  createdAt    DateTime    @default(now())
  firma        Firma       @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  rechnung     Rechnung    @relation(fields: [rechnungId], references: [id])
  bankumsatz   Bankumsatz? @relation(fields: [bankumsatzId], references: [id], onDelete: SetNull)
  erfasstVon   Benutzer?   @relation(fields: [erfasstVonId], references: [id], onDelete: SetNull)

  @@index([rechnungId])
  @@index([firmaId, datum])
}

/// Umsatz aus dem Kontoauszug (CAMT.053). `referenz` verhindert doppelten Import.
model Bankumsatz {
  id               String    @id @default(cuid())
  firmaId          String
  referenz         String
  buchungstag      DateTime
  betrag           Decimal   @db.Decimal(12, 2) // Eingang positiv, Ausgang negativ
  name             String?
  iban             String?
  verwendungszweck String?
  quelle           String?
  erledigt         Boolean   @default(false) // zugeordnet oder bewusst übergangen
  createdAt        DateTime  @default(now())
  firma            Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  zahlungen        Zahlung[]

  @@unique([firmaId, referenz])
  @@index([firmaId, erledigt, buchungstag])
}

model Mahnung {
  id            String    @id @default(cuid())
  firmaId       String
  rechnungId    String
  stufe         Int // 1 Zahlungserinnerung, 2 erste Mahnung, 3 letzte Mahnung
  datum         DateTime  @default(now())
  frist         DateTime
  offen         Decimal   @db.Decimal(12, 2)
  gebuehr       Decimal   @default(0) @db.Decimal(12, 2)
  zinsen        Decimal   @default(0) @db.Decimal(12, 2)
  pauschale     Decimal   @default(0) @db.Decimal(12, 2) // § 288 Abs. 5 BGB
  pdf           Bytes?
  erstelltVonId String?
  firma         Firma     @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  rechnung      Rechnung  @relation(fields: [rechnungId], references: [id])
  erstelltVon   Benutzer? @relation(fields: [erstelltVonId], references: [id], onDelete: SetNull)

  @@index([rechnungId])
}

// ---------------------------------------------------------------- Einkauf
// Bestellung → Wareneingang (Lieferschein) → Eingangsrechnung. Die Rechnungsprüfung
// vergleicht, was bestellt, was geliefert und was berechnet wurde.

enum BestellStatus {
  ENTWURF // Bestellanforderung, auch von Kolonnen
  BESTELLT
  TEILGELIEFERT
  GELIEFERT
  ABGESCHLOSSEN
  STORNIERT
}

model Bestellung {
  id             String             @id @default(cuid())
  firmaId        String
  nummer         String? // erst beim Bestellen vergeben
  lieferantId    String?
  projektId      String?
  lagerId        String? // Lieferung ins Lager (sonst direkt auf die Baustelle)
  status         BestellStatus      @default(ENTWURF)
  betreff        String
  lieferadresse  String?
  liefertermin   DateTime?
  notiz          String?
  netto          Decimal            @default(0) @db.Decimal(12, 2)
  bestelltAm     DateTime?
  erstelltVonId  String?
  bestelltVonId  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  firma          Firma              @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  lieferant      Kontakt?           @relation(fields: [lieferantId], references: [id])
  projekt        Projekt?           @relation(fields: [projektId], references: [id], onDelete: SetNull)
  lager          Lager?             @relation(fields: [lagerId], references: [id], onDelete: SetNull)
  erstelltVon    Benutzer?          @relation("BestellungErsteller", fields: [erstelltVonId], references: [id], onDelete: SetNull)
  bestelltVon    Benutzer?          @relation("BestellungBesteller", fields: [bestelltVonId], references: [id], onDelete: SetNull)
  positionen     BestellPosition[]
  wareneingaenge Wareneingang[]
  rechnungen     Eingangsrechnung[]

  lieferscheine Lieferschein[]

  @@index([firmaId, status])
  @@index([lieferantId])
}

model BestellPosition {
  id                  String                 @id @default(cuid())
  bestellungId        String
  reihenfolge         Int
  artikelId           String?
  artNr               String? // Artikelnummer des Lieferanten
  text                String
  menge               Decimal                @db.Decimal(12, 3)
  einheit             String                 @default("Stk.")
  preis               Decimal                @default(0) @db.Decimal(12, 4) // EK netto je Einheit
  geliefert           Decimal                @default(0) @db.Decimal(12, 3)
  berechnet           Decimal                @default(0) @db.Decimal(12, 3)
  bestellung          Bestellung             @relation(fields: [bestellungId], references: [id], onDelete: Cascade)
  artikel             Artikel?               @relation(fields: [artikelId], references: [id], onDelete: SetNull)
  eingaenge           WareneingangPosition[]
  rechnungsPositionen EingangsPosition[]

  @@index([bestellungId, reihenfolge])
}

model Wareneingang {
  id            String                 @id @default(cuid())
  bestellungId  String
  datum         DateTime
  lieferschein  String?
  notiz         String?
  benutzerId    String?
  createdAt     DateTime               @default(now())
  bestellung    Bestellung             @relation(fields: [bestellungId], references: [id], onDelete: Cascade)
  benutzer      Benutzer?              @relation(fields: [benutzerId], references: [id], onDelete: SetNull)
  positionen    WareneingangPosition[]
  lieferscheine Lieferschein[]
}

model WareneingangPosition {
  id                String          @id @default(cuid())
  wareneingangId    String
  bestellPositionId String
  menge             Decimal         @db.Decimal(12, 3)
  lagerBuchungId    String?
  wareneingang      Wareneingang    @relation(fields: [wareneingangId], references: [id], onDelete: Cascade)
  bestellPosition   BestellPosition @relation(fields: [bestellPositionId], references: [id], onDelete: Cascade)
  lagerBuchung      LagerBuchung?   @relation(fields: [lagerBuchungId], references: [id], onDelete: SetNull)
}

enum EingangsStatus {
  NEU // eingegangen, noch nicht geprüft
  PRUEFUNG // geprüft, wartet auf Freigabe
  FREIGEGEBEN // zur Zahlung freigegeben
  ABGELEHNT // reklamiert
  BEZAHLT
}

enum Kostenart2 {
  MATERIAL
  FREMDLEISTUNG
  GERAETE
  SONSTIGES
}

model Eingangsrechnung {
  id               String             @id @default(cuid())
  firmaId          String
  status           EingangsStatus     @default(NEU)
  quelle           String // UPLOAD, EMAIL
  format           String // XRECHNUNG_CII, XRECHNUNG_UBL, ZUGFERD, PDF
  dateiName        String
  datei            Bytes
  dateiHash        String? // SHA-256, erkennt dieselbe Datei aus zwei Postfächern
  xml              String?
  daten            Json? // gelesene Angaben nach EN 16931 (BT-…)
  lieferantId      String?
  lieferantName    String?
  lieferantUstId   String?
  iban             String?
  rechnungsnummer  String?
  datum            DateTime?
  faellig          DateTime?
  leistungsdatum   String?
  bestellnummer    String? // Bestellreferenz des Lieferanten (BT-13)
  netto            Decimal            @default(0) @db.Decimal(12, 2)
  mwst             Decimal            @default(0) @db.Decimal(12, 2)
  brutto           Decimal            @default(0) @db.Decimal(12, 2)
  vorauszahlung    Decimal            @default(0) @db.Decimal(12, 2)
  zahlbetrag       Decimal            @default(0) @db.Decimal(12, 2)
  steuerUmkehr     Boolean            @default(false) // § 13b: wir schulden die Steuer
  skontoProzent    Decimal            @default(0) @db.Decimal(4, 2)
  skontoTage       Int                @default(0)
  bestellungId     String?
  projektId        String?
  kostenart        Kostenart2         @default(MATERIAL)
  pruefung         Json? // Ergebnis der automatischen Prüfung
  freigegebenVonId String?
  freigegebenAm    DateTime?
  freigabeNotiz    String?
  ablehnGrund      String?
  bezahltAm        DateTime?
  bezahltBetrag    Decimal?           @db.Decimal(12, 2)
  emailId          String?
  notiz            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  firma            Firma              @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  lieferant        Kontakt?           @relation(fields: [lieferantId], references: [id])
  bestellung       Bestellung?        @relation(fields: [bestellungId], references: [id], onDelete: SetNull)
  projekt          Projekt?           @relation(fields: [projektId], references: [id], onDelete: SetNull)
  freigegebenVon   Benutzer?          @relation("EingangFreigabe", fields: [freigegebenVonId], references: [id], onDelete: SetNull)
  email            Email?             @relation(fields: [emailId], references: [id], onDelete: SetNull)
  positionen       EingangsPosition[]

  lieferscheine Lieferschein[]

  @@index([firmaId, status])
  @@index([lieferantId, rechnungsnummer])
  @@index([firmaId, dateiHash])
}

model EingangsPosition {
  id                String           @id @default(cuid())
  rechnungId        String
  nr                Int
  artNr             String?
  text              String
  menge             Decimal          @db.Decimal(12, 3)
  einheit           String?
  preis             Decimal          @db.Decimal(12, 4)
  gesamt            Decimal          @db.Decimal(12, 2)
  steuersatz        Decimal?         @db.Decimal(4, 2)
  bestellPositionId String?
  rechnung          Eingangsrechnung @relation(fields: [rechnungId], references: [id], onDelete: Cascade)
  bestellPosition   BestellPosition? @relation(fields: [bestellPositionId], references: [id], onDelete: SetNull)

  @@index([rechnungId])
}

// ---------------------------------------------------------------- Lieferscheine
// Kauf auf Lieferschein (z. B. Kleinmaterial im Baustoffhandel) und Lieferscheine zu
// Bestellungen. Die Sammelrechnung des Händlers wird gegen die Lieferscheine geprüft.

enum LieferscheinStatus {
  OFFEN // noch nicht abgerechnet
  ABGERECHNET // in einer freigegebenen Eingangsrechnung enthalten
  STORNIERT
}

model Lieferschein {
  id                 String              @id @default(cuid())
  firmaId            String
  status             LieferscheinStatus  @default(OFFEN)
  quelle             String // FOTO, UPLOAD, EMAIL, WARENEINGANG
  lieferantId        String?
  lieferantName      String? // solange kein Kontakt zugeordnet ist
  nummer             String? // Lieferschein-Nr. des Händlers
  datum              DateTime
  projektId          String?
  bestellungId       String?
  wareneingangId     String?
  eingangsrechnungId String?
  betrag             Decimal?            @db.Decimal(12, 2) // netto, falls auf dem Lieferschein
  notiz              String?
  erfasstVonId       String?
  emailId            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  firma              Firma               @relation(fields: [firmaId], references: [id], onDelete: Cascade)
  lieferant          Kontakt?            @relation(fields: [lieferantId], references: [id])
  projekt            Projekt?            @relation(fields: [projektId], references: [id], onDelete: SetNull)
  bestellung         Bestellung?         @relation(fields: [bestellungId], references: [id], onDelete: SetNull)
  wareneingang       Wareneingang?       @relation(fields: [wareneingangId], references: [id], onDelete: SetNull)
  eingangsrechnung   Eingangsrechnung?   @relation(fields: [eingangsrechnungId], references: [id], onDelete: SetNull)
  erfasstVon         Benutzer?           @relation(fields: [erfasstVonId], references: [id], onDelete: SetNull)
  email              Email?              @relation(fields: [emailId], references: [id], onDelete: SetNull)
  dateien            LieferscheinDatei[]

  @@index([firmaId, status, datum])
  @@index([lieferantId, status])
  @@index([projektId])
}

model LieferscheinDatei {
  id             String       @id @default(cuid())
  lieferscheinId String
  name           String
  typ            String // image/jpeg, image/png, image/webp, image/heic, application/pdf
  groesse        Int
  hash           String
  daten          Bytes
  createdAt      DateTime     @default(now())
  lieferschein   Lieferschein @relation(fields: [lieferscheinId], references: [id], onDelete: Cascade)

  @@index([hash])
}
